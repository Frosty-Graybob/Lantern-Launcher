{
  "name": "game-launcher-server",
  "version": "1.1.0",
  "description": "Game Launcher server: serves your game library to the Game Launcher app",
  "main": "app/main.js",
  "scripts": {
    "start": "node src/cli.js",
    "app": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.gamelauncher.server",
    "productName": "Game Launcher Server",
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "app/assets",
        "to": "assets",
        "filter": [
          "icon.ico"
        ]
      }
    ]
  }
}
